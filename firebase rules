{
  "rules": {
    "buildingData": {
      ".read": "auth != null",
      ".write": "auth != null && (
        root.child('users').child(auth.uid).child('role').val() === 'admin' ||
        root.child('users').child(auth.uid).child('role').val() === 'manager'
      )"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (
          auth.uid === $uid ||
          root.child('users').child(auth.uid).child('role').val() === 'admin' ||
          root.child('users').child(auth.uid).child('role').val() === 'manager'
        )",
        ".write": "auth != null && (
          root.child('users').child(auth.uid).child('role').val() === 'admin' ||
          (
            root.child('users').child(auth.uid).child('role').val() === 'manager' &&
            newData.child('role').val() === 'resident'
          )
        )"
      }
    },
    "supportBackups": {
      ".read": "auth != null && auth.email === 'admin@test.com'",
      ".write": "auth != null"
    }
  }
}
